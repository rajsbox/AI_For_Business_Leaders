---
import BaseLayout from '../layouts/BaseLayout.astro';
import { futureTopics, lastReviewed } from '../data/futureTopics';

// See BaseLayout.astro for why this normalizes to a guaranteed trailing slash.
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const categories = ['Not covered in the course', 'New since Day 30 was written', 'Woven into the course'] as const;
---

<BaseLayout
  title="Future Topics | AI Fluency for Leaders"
  description="Headlines for what the 30-day course didn't cover, and what's changed in AI since. Reviewed roughly every 2 days."
>
  <main class="container future-page">
    <nav class="future-crumb">
      <a href={base}>← ROADMAP</a>
    </nav>

    <header class="future-header">
      <span class="badge">FUTURE TOPICS</span>
      <h1 class="future-header__title">What's next</h1>
      <p class="future-header__lede">
        Headlines only — no lessons here yet. This page tracks two things: topics the 30-day
        course didn't cover, and genuinely new developments in AI since it was written.
        Reviewed roughly every 2 days.
      </p>
      <p class="future-header__reviewed">Last reviewed: <strong>{lastReviewed}</strong></p>
    </header>

    {categories.map((cat) => {
      const items = futureTopics.filter((t) => t.category === cat);
      if (items.length === 0) return null;
      return (
        <section class="future-section">
          <h2 class="future-section__title">{cat}</h2>
          <ul class="future-list">
            {items.map((t) => (
              <li class="future-item">
                <p class="future-item__headline">{t.headline}</p>
                <p class="future-item__note">{t.note}</p>
              </li>
            ))}
          </ul>
        </section>
      );
    })}

    {futureTopics.length === 0 && (
      <p class="future-empty">Nothing flagged right now — check back after the next review.</p>
    )}
  </main>
</BaseLayout>

<style>
  .future-page {
    max-width: 760px;
    padding: 32px 24px 96px;
  }

  .future-crumb {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    margin-bottom: 20px;
  }

  .future-crumb a {
    color: var(--sub);
  }

  .future-crumb a:hover {
    color: var(--blue);
  }

  .future-header {
    padding-bottom: 28px;
    margin-bottom: 28px;
    border-bottom: 2px solid var(--rule);
  }

  .future-header .badge {
    background: var(--rule);
    color: var(--paper);
    margin-bottom: 14px;
  }

  .future-header__title {
    margin: 0 0 14px;
    font-weight: 900;
    font-size: clamp(32px, 5vw, 48px);
    letter-spacing: -0.04em;
    text-transform: uppercase;
    line-height: 0.95;
  }

  .future-header__lede {
    margin: 0 0 12px;
    font-size: 0.96rem;
    font-weight: 500;
    line-height: 1.6;
    color: var(--sub);
    max-width: 58ch;
  }

  .future-header__reviewed {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    color: var(--mute);
    text-transform: uppercase;
  }

  .future-section {
    margin-bottom: 36px;
  }

  .future-section__title {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--mute);
    margin: 0 0 16px;
  }

  .future-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .future-item {
    padding: 16px 0;
    border-top: 1px solid var(--faint);
  }

  .future-item:first-child {
    border-top: none;
  }

  .future-item__headline {
    margin: 0 0 4px;
    font-weight: 800;
    font-size: 1.02rem;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .future-item__note {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--sub);
  }

  .future-empty {
    color: var(--mute);
    font-size: 0.92rem;
  }
</style>
