---
import { getCollection, render } from 'astro:content';
import DayLayout from '../../layouts/DayLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('days');
  return entries.map((entry) => ({
    params: { day: String(entry.data.day) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { day, week, title, duration, handsOn, published } = entry.data;
---

<DayLayout day={day} week={week} title={title} duration={duration} handsOn={handsOn} published={published}>
  <Content />
</DayLayout>
