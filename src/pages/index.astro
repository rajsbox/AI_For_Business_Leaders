---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { weeks, days as courseDays } from '../data/course';

const entries = await getCollection('days');
const publishedByDay = new Map(entries.map((e) => [e.data.day, e.data.published]));
const publishedCount = [...publishedByDay.values()].filter(Boolean).length;
// See BaseLayout.astro for why this normalizes to a guaranteed trailing slash.
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout title="30-Day AI Fluency Course for Business Leaders">
  <main class="home">
    <div class="ticker" aria-hidden="true">
      <div class="ticker__track">
        <span>TOKENS</span><span class="ticker__dot">◆</span><span>CONTEXT ENGINEERING</span><span class="ticker__dot">◆</span><span>AGENTIC AI</span><span class="ticker__dot">◆</span><span>TEST-TIME COMPUTE</span><span class="ticker__dot">◆</span><span>OPEN-WEIGHT MODELS</span><span class="ticker__dot">◆</span><span>MULTIMODAL</span><span class="ticker__dot">◆</span><span>AI STRATEGY</span><span class="ticker__dot">◆</span>
        <span>TOKENS</span><span class="ticker__dot">◆</span><span>CONTEXT ENGINEERING</span><span class="ticker__dot">◆</span><span>AGENTIC AI</span><span class="ticker__dot">◆</span><span>TEST-TIME COMPUTE</span><span class="ticker__dot">◆</span><span>OPEN-WEIGHT MODELS</span><span class="ticker__dot">◆</span><span>MULTIMODAL</span><span class="ticker__dot">◆</span><span>AI STRATEGY</span><span class="ticker__dot">◆</span>
      </div>
    </div>
    <section class="hero">
      <div class="container hero__inner">
        <div class="hero__lead">
          <div class="hero__kicker"><span class="hero__kicker-bar"></span>30 DAYS · ONE TOPIC A DAY</div>
          <h1 class="hero__title">AI Fluency<br>for Business<br><span class="hero__title-accent">Leaders</span></h1>
          <p class="hero__lede">
            A daily, no-fluff path to speaking AI credibly — from how LLMs work to writing your
            own AI strategy. ~45–60 minutes a day, headings-driven, built one day at a time.
          </p>
          <div class="hero__actions">
            <a class="btn btn--primary" href={`${base}day/1`} data-resume-link>Start Day 1</a>
            <a class="btn btn--ghost" href="#roadmap">View the track</a>
          </div>
        </div>
        <div class="hero__counter">
          <div class="hero__counter-top">
            <div class="hero__counter-label" data-counter-label>PUBLISHED</div>
            <div class="hero__counter-big" data-counter-big>{String(publishedCount).padStart(2, '0')}</div>
            <div class="hero__counter-sub">of {courseDays.length} days</div>
          </div>
          <div class="hero__grid">
            {courseDays.map((d) => {
              const isPublished = publishedByDay.get(d.day) ?? false;
              return (
                <a
                  href={`${base}day/${d.day}`}
                  class={`hero__cell ${isPublished ? 'hero__cell--filled' : ''}`}
                  title={`Day ${d.day}`}
                  aria-label={`Day ${d.day}${isPublished ? '' : ' — not published yet'}`}
                ></a>
              );
            })}
          </div>
        </div>
      </div>
      <p class="hero__your-progress container" data-your-progress hidden></p>
    </section>

    <section id="roadmap" class="roadmap container">
      {weeks.map((w) => (
        <div class="week-block" id={`week-${w.week}`}>
          <div class="week-block__header">
            <span class="week-block__tag">WEEK {String(w.week).padStart(2, '0')}</span>
            <h2>{w.title}</h2>
          </div>
          <ol class="track" data-track>
            {courseDays
              .filter((d) => d.week === w.week)
              .map((d) => {
                const isPublished = publishedByDay.get(d.day) ?? false;
                return (
                  <li class="track__row" data-day={d.day} data-published={String(isPublished)}>
                    <a class={`track__link ${isPublished ? 'track__link--open' : 'track__link--locked'}`} href={`${base}day/${d.day}`}>
                      <span class="track__num">{String(d.day).padStart(2, '0')}</span>
                      <span class="track__title">{d.title}</span>
                      {d.handsOn && <span class="badge badge--hands-on">Hands-on</span>}
                      <span class="track__status" data-track-status>
                        {isPublished ? 'OPEN' : 'SOON'}
                      </span>
                    </a>
                  </li>
                );
              })}
          </ol>
        </div>
      ))}
    </section>
  </main>
</BaseLayout>

<script>
  import { loadProgress, nextDay, currentStreak } from '../lib/progress';

  function initTrack() {
    const total = document.querySelectorAll('[data-track] .track__row').length;
    if (total === 0) return;

    const { done } = loadProgress();
    const doneSet = new Set(done);
    const upNext = nextDay(total);
    const streak = currentStreak();

    document.querySelectorAll<HTMLElement>('[data-track] .track__row').forEach((row) => {
      const day = Number(row.dataset.day);
      const isDone = doneSet.has(day);
      const isCurrent = !isDone && day === upNext;
      row.classList.toggle('is-done', isDone);
      row.classList.toggle('is-current', isCurrent);

      const status = row.querySelector<HTMLElement>('[data-track-status]');
      if (status && (isDone || isCurrent)) {
        status.textContent = isDone ? 'DONE' : 'CONTINUE →';
      }
    });

    document.querySelectorAll<HTMLAnchorElement>('.hero__cell').forEach((cell, i) => {
      const day = i + 1;
      if (doneSet.has(day)) cell.classList.add('hero__cell--filled');
    });

    const counterBig = document.querySelector<HTMLElement>('[data-counter-big]');
    const counterLabel = document.querySelector<HTMLElement>('[data-counter-label]');
    if (done.length > 0) {
      if (counterBig) counterBig.textContent = String(done.length).padStart(2, '0');
      if (counterLabel) counterLabel.textContent = 'COMPLETED';
    }

    const resumeLinks = document.querySelectorAll<HTMLAnchorElement>('[data-resume-link]');
    if (resumeLinks.length > 0 && done.length > 0) {
      const clientBase = import.meta.env.BASE_URL.endsWith('/')
        ? import.meta.env.BASE_URL
        : `${import.meta.env.BASE_URL}/`;
      const label = doneSet.has(upNext) ? 'REVIEW THE COURSE' : `RESUME DAY ${String(upNext).padStart(2, '0')}`;
      resumeLinks.forEach((link) => {
        link.href = `${clientBase}day/${upNext}`;
        link.textContent = label;
      });
    }

    const yourProgress = document.querySelector<HTMLElement>('[data-your-progress]');
    if (yourProgress && done.length > 0) {
      yourProgress.hidden = false;
      yourProgress.textContent = streak > 0
        ? `You've completed ${done.length} of ${total} days · ${streak} day streak`
        : `You've completed ${done.length} of ${total} days`;
    }
  }

  initTrack();
  document.addEventListener('astro:page-load', initTrack);
</script>

<style>
  .home {
    padding: 0 0 60px;
  }

  /* ---------------- Hero ---------------- */

  .hero {
    border-bottom: 2px solid var(--rule);
    padding: 56px 0 44px;
    background-image:
      linear-gradient(var(--faint) 1px, transparent 1px),
      linear-gradient(90deg, var(--faint) 1px, transparent 1px);
    background-size: 52px 52px;
    background-position: center;
  }

  .hero__inner {
    display: flex;
    flex-wrap: wrap;
    gap: 34px;
    align-items: stretch;
  }

  .hero__lead {
    flex: 1 1 480px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .hero__kicker {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    color: var(--blue);
  }

  .hero__kicker-bar {
    width: 22px;
    height: 2px;
    background: var(--blue);
  }

  .hero__title {
    margin: 0;
    font-weight: 900;
    font-size: clamp(38px, 5.4vw, 64px);
    line-height: 0.92;
    letter-spacing: -0.045em;
    text-transform: uppercase;
  }

  .hero__title-accent {
    color: var(--blue);
  }

  .hero__lede {
    margin: 0;
    max-width: 480px;
    font-size: 0.94rem;
    font-weight: 500;
    line-height: 1.6;
    color: var(--sub);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 6px;
  }

  .hero__counter {
    flex: 0 1 230px;
    border-left: 2px solid var(--rule);
    padding-left: 22px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 22px;
  }

  .hero__counter-top {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .hero__counter-label {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    color: var(--mute);
  }

  .hero__counter-big {
    font-weight: 900;
    font-size: 4.4rem;
    line-height: 0.85;
    letter-spacing: -0.06em;
  }

  .hero__counter-sub {
    font-weight: 700;
    font-size: 0.8rem;
    color: var(--mute);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 4px;
  }

  .hero__cell {
    aspect-ratio: 1;
    border: 1px solid var(--faint);
    display: block;
  }

  .hero__cell:hover {
    border-color: var(--blue);
  }

  .hero__cell--filled {
    background: var(--blue);
    border-color: var(--blue);
  }

  .hero__your-progress {
    margin: 20px auto 0;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--mute);
    text-transform: uppercase;
  }

  /* ---------------- Roadmap / weeks ---------------- */

  .roadmap {
    padding-top: 36px;
  }

  .week-block {
    margin-bottom: 40px;
    scroll-margin-top: 84px;
  }

  .week-block__header {
    display: flex;
    align-items: baseline;
    gap: 14px;
    margin-bottom: 22px;
    flex-wrap: wrap;
  }

  .week-block__tag {
    background: var(--rule);
    color: var(--paper);
    padding: 6px 11px;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.62rem;
    letter-spacing: 0.14em;
  }

  .week-block__header h2 {
    font-size: clamp(17px, 2.2vw, 23px);
    font-weight: 800;
    letter-spacing: -0.025em;
    text-transform: uppercase;
    margin: 0;
  }

  /* ---------------- Track (day rows) ---------------- */

  .track {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .track__row {
    border-top: 1px solid var(--faint);
  }

  .track__row:first-child {
    border-top: none;
  }

  .track__link {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    padding: 15px 0;
    color: var(--ink);
  }

  .track__link:hover {
    color: var(--ink);
    background: var(--card);
  }

  .track__num {
    width: 56px;
    flex-shrink: 0;
    font-weight: 900;
    font-size: 1.3rem;
    letter-spacing: -0.05em;
    color: var(--faint);
    text-align: center;
  }

  .track__title {
    flex: 1 1 280px;
    font-weight: 600;
    font-size: 0.9rem;
    line-height: 1.35;
    color: var(--sub);
  }

  .track__status {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--mute);
  }

  /* Open (published) days: bolder number */
  .track__link--open .track__num {
    color: var(--mute);
  }

  /* Done */
  .track__row.is-done .track__num {
    color: var(--blue);
  }

  .track__row.is-done .track__title {
    color: var(--mute);
  }

  .track__row.is-done .track__status {
    color: var(--blue);
  }

  /* Current / up-next */
  .track__row.is-current .track__num {
    color: var(--blue);
  }

  .track__row.is-current .track__title {
    font-weight: 800;
    color: var(--ink);
  }

  .track__row.is-current .track__status {
    color: var(--blue);
  }

  @media (max-width: 640px) {
    .track__link {
      align-items: flex-start;
    }
    .hero__counter {
      border-left: none;
      border-top: 2px solid var(--rule);
      padding-left: 0;
      padding-top: 22px;
      flex-basis: 100%;
    }
  }
</style>
