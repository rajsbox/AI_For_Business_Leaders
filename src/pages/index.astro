---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { weeks, days as courseDays } from '../data/course';

const entries = await getCollection('days');
const publishedByDay = new Map(entries.map((e) => [e.data.day, e.data.published]));
const publishedCount = [...publishedByDay.values()].filter(Boolean).length;
// See BaseLayout.astro for why this normalizes to a guaranteed trailing slash.
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const totalDays = courseDays.length;
const weekMeta = weeks.map((w) => {
  const weekDays = courseDays.filter((d) => d.week === w.week);
  const first = weekDays[0]?.day ?? 0;
  const last = weekDays[weekDays.length - 1]?.day ?? 0;
  return { ...w, first, last, count: weekDays.length };
});
---

<BaseLayout title="30-Day AI Fluency Course for Business Leaders">
  <main class="tv-home">
    <section class="tv-hero">
      <div class="container tv-hero__inner">
        <div class="tv-hero__lead">
          <div class="tv-hero__kicker"><span class="tv-hero__kicker-bar"></span>30 DAYS · ONE TOPIC A DAY</div>
          <h1 class="tv-hero__title">AI fluency for<br>business leaders</h1>
          <p class="tv-hero__lede">
            A daily, no-fluff path to speaking AI credibly — from how LLMs work to writing your own
            AI strategy. About 45 minutes a day, built one day at a time.
          </p>
          <div class="tv-hero__actions">
            <a class="tv-btn tv-btn--primary" href={`${base}day/1`} data-resume-link>Start Day 1 <span class="tv-arrow">→</span></a>
            <a class="tv-btn tv-btn--ghost" href="#roadmap">See the 30 days</a>
          </div>
        </div>

        <div class="tv-progress">
          <div class="tv-progress__top">
            <span class="tv-progress__label">Your progress</span>
            <span class="tv-progress__saved">saved on this device</span>
          </div>
          <div class="tv-progress__count">
            <span class="tv-progress__big" data-progress-count>0</span>
            <span class="tv-progress__of">of {totalDays} days read</span>
          </div>
          <div class="tv-progress__bar">
            <div class="tv-progress__bar-fill" data-progress-bar style="width: 0%;"></div>
          </div>
          <div class="tv-progress__grid" data-progress-grid>
            {courseDays.map((d) => {
              const isPublished = publishedByDay.get(d.day) ?? false;
              return isPublished ? (
                <a
                  href={`${base}day/${d.day}`}
                  class="tv-progress__cell"
                  data-day={d.day}
                  title={`Day ${d.day}`}
                  aria-label={`Day ${d.day}`}
                >{String(d.day).padStart(2, '0')}</a>
              ) : (
                <span
                  class="tv-progress__cell tv-progress__cell--stub"
                  data-day={d.day}
                  title={`Day ${d.day} — not published yet`}
                  aria-label={`Day ${d.day} — not published yet`}
                >{String(d.day).padStart(2, '0')}</span>
              );
            })}
          </div>
          <p class="tv-progress__next" data-progress-next>Pick up at Day 1. Mark a day done at the end of its page.</p>
        </div>
      </div>
    </section>

    <div class="tv-ticker" aria-hidden="true">
      <div class="tv-ticker__track">
        <span>TOKENS &nbsp;·&nbsp; CONTEXT ENGINEERING &nbsp;·&nbsp; AGENTIC AI &nbsp;·&nbsp; TEST-TIME COMPUTE &nbsp;·&nbsp; OPEN-WEIGHT MODELS &nbsp;·&nbsp; MULTIMODAL &nbsp;·&nbsp; RAG &nbsp;·&nbsp; EVALS &nbsp;·&nbsp; TOKENOMICS &nbsp;·&nbsp; AI STRATEGY &nbsp;·&nbsp; </span><span>TOKENS &nbsp;·&nbsp; CONTEXT ENGINEERING &nbsp;·&nbsp; AGENTIC AI &nbsp;·&nbsp; TEST-TIME COMPUTE &nbsp;·&nbsp; OPEN-WEIGHT MODELS &nbsp;·&nbsp; MULTIMODAL &nbsp;·&nbsp; RAG &nbsp;·&nbsp; EVALS &nbsp;·&nbsp; TOKENOMICS &nbsp;·&nbsp; AI STRATEGY &nbsp;·&nbsp; </span>
      </div>
    </div>

    <section id="roadmap" class="tv-track container">
      <div class="tv-track__header">
        <h2>The track</h2>
        <span class="tv-track__meta">4 weeks · 30 topics · {publishedCount} of {totalDays} published</span>
      </div>

      {weekMeta.map((w) => (
        <div class="tv-week" id={`week-${w.week}`}>
          <div class="tv-week__side">
            <div class="tv-week__num">WEEK {String(w.week).padStart(2, '0')}</div>
            <h3 class="tv-week__title">{w.title}</h3>
            <div class="tv-week__meta">Days {w.first}–{w.last} · {w.count} topics</div>
          </div>
          <div class="tv-week__days">
            {courseDays
              .filter((d) => d.week === w.week)
              .map((d) => {
                const isPublished = publishedByDay.get(d.day) ?? false;
                return (
                  <a
                    class="tv-day-row"
                    data-day={d.day}
                    data-published={String(isPublished)}
                    href={isPublished ? `${base}day/${d.day}` : undefined}
                    aria-disabled={isPublished ? undefined : 'true'}
                  >
                    <span class="tv-day-row__num">{String(d.day).padStart(2, '0')}</span>
                    <span class="tv-day-row__title">{d.title}</span>
                    {d.handsOn && <span class="tv-pill">Hands-on</span>}
                    {isPublished ? (
                      <span class="tv-day-row__arrow" data-track-status>→</span>
                    ) : (
                      <span class="tv-day-row__soon">SOON</span>
                    )}
                  </a>
                );
              })}
          </div>
        </div>
      ))}
    </section>

    <section class="tv-cta">
      <div class="container tv-cta__inner">
        <div class="tv-cta__copy">
          <h2>One topic a day.</h2>
          <p>Thirty days from now you'll run the AI meeting instead of nodding through it.</p>
        </div>
        <a class="tv-btn tv-btn--inverse" href={`${base}day/1`} data-resume-link>Start Day 1 <span class="tv-arrow">→</span></a>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  import { loadProgress, nextDay } from '../lib/progress';

  function initProgress() {
    const grid = document.querySelector('[data-progress-grid]');
    if (!grid) return;

    const total = grid.querySelectorAll('[data-day]').length;
    if (total === 0) return;

    const { done } = loadProgress();
    const doneSet = new Set(done);
    const doneCount = done.length;
    const upNext = nextDay(total);

    grid.querySelectorAll<HTMLElement>('[data-day]').forEach((cell) => {
      const day = Number(cell.dataset.day);
      if (doneSet.has(day)) cell.classList.add('tv-progress__cell--filled');
    });

    const countEl = document.querySelector<HTMLElement>('[data-progress-count]');
    if (countEl) countEl.textContent = String(doneCount);

    const barEl = document.querySelector<HTMLElement>('[data-progress-bar]');
    if (barEl) barEl.style.width = `${Math.round((doneCount / total) * 100)}%`;

    const nextEl = document.querySelector<HTMLElement>('[data-progress-next]');
    if (nextEl) {
      nextEl.textContent = doneCount >= total
        ? 'All 30 days read. The capstone plan is yours to pressure-test.'
        : `Pick up at Day ${upNext}. Mark a day done at the end of its page.`;
    }

    document.querySelectorAll<HTMLElement>('[data-track] , .tv-day-row').forEach(() => {});

    document.querySelectorAll<HTMLAnchorElement>('.tv-day-row').forEach((row) => {
      const day = Number(row.dataset.day);
      const isDone = doneSet.has(day);
      const isCurrent = !isDone && day === upNext;
      row.classList.toggle('is-done', isDone);
      row.classList.toggle('is-current', isCurrent);
      const status = row.querySelector<HTMLElement>('[data-track-status]');
      if (status && isDone) status.textContent = '✓';
    });

    const resumeLinks = document.querySelectorAll<HTMLAnchorElement>('[data-resume-link]');
    if (resumeLinks.length > 0 && doneCount > 0) {
      const clientBase = import.meta.env.BASE_URL.endsWith('/')
        ? import.meta.env.BASE_URL
        : `${import.meta.env.BASE_URL}/`;
      const label = doneSet.has(upNext) ? 'Review the course →' : `Resume Day ${upNext} →`;
      resumeLinks.forEach((link) => {
        link.href = `${clientBase}day/${upNext}`;
        link.textContent = label;
      });
    }
  }

  initProgress();
  document.addEventListener('astro:page-load', initProgress);
</script>

<style>
  /* ------------------------------------------------------------------
     Homepage-only "editorial" design — scoped entirely to this page.
     Deliberately independent of the sitewide Signal Grid tokens in
     global.css (different fonts, palette, and visual treatment).
  ------------------------------------------------------------------ */
  @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&family=Instrument+Serif:ital@0;1&display=swap');

  .tv-home {
    --tv-paper: #fbfaf8;
    --tv-ink: #14140f;
    --tv-sub: #46453e;
    --tv-mute: #6b6a63;
    --tv-mute-2: #8a887f;
    --tv-border: #e4e1da;
    --tv-border-2: #edeae3;
    --tv-faint: #a8a69d;
    --tv-faint-2: #c4c1b8;
    --tv-faint-3: #d8d4cb;
    --tv-faint-4: #ddd9d0;
    --tv-faint-5: #9a9890;
    --tv-accent: #1f3bff;
    --tv-accent-soft-bg: #f2f4ff;
    --tv-accent-soft-border: #c9cfff;
    --tv-card: #ffffff;
    --tv-ticker-text: var(--tv-faint);

    background: var(--tv-paper);
    color: var(--tv-ink);
    font-family: 'IBM Plex Sans', system-ui, -apple-system, 'Segoe UI', sans-serif;
    padding: 0 0 0;
  }

  @media (prefers-color-scheme: dark) {
    .tv-home:not([data-theme='light']) {
      --tv-paper: #14140f;
      --tv-ink: #fbfaf8;
      --tv-sub: #d8d5cc;
      --tv-mute: #a8a69d;
      --tv-mute-2: #9a9890;
      --tv-border: #2b2a24;
      --tv-border-2: #232219;
      --tv-faint: #55534a;
      --tv-faint-2: #45443c;
      --tv-faint-3: #3a3931;
      --tv-faint-4: #2f2e27;
      --tv-faint-5: #6b6a63;
      --tv-accent: #5470ff;
      --tv-accent-soft-bg: #1a1e33;
      --tv-accent-soft-border: #33396b;
      --tv-card: #1c1b16;
      --tv-ticker-text: #fbfaf8;
    }
  }

  :global(:root[data-theme='dark']) .tv-home {
    --tv-paper: #14140f;
    --tv-ink: #fbfaf8;
    --tv-sub: #d8d5cc;
    --tv-mute: #a8a69d;
    --tv-mute-2: #9a9890;
    --tv-border: #2b2a24;
    --tv-border-2: #232219;
    --tv-faint: #55534a;
    --tv-faint-2: #45443c;
    --tv-faint-3: #3a3931;
    --tv-faint-4: #2f2e27;
    --tv-faint-5: #6b6a63;
    --tv-accent: #5470ff;
    --tv-accent-soft-bg: #1a1e33;
    --tv-accent-soft-border: #33396b;
    --tv-card: #1c1b16;
    --tv-ticker-text: #fbfaf8;
  }

  :global(:root[data-theme='light']) .tv-home {
    --tv-card: #ffffff;
    --tv-ticker-text: var(--tv-faint);
  }

  .tv-home .container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 clamp(20px, 4vw, 56px);
  }

  .tv-home a {
    color: inherit;
    text-decoration: none;
  }

  /* ---------------- Hero ---------------- */

  .tv-hero {
    padding: clamp(56px, 7vw, 96px) 0 0;
  }

  .tv-hero__inner {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: clamp(40px, 6vw, 88px);
    align-items: end;
  }

  .tv-hero__kicker {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 28px;
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--tv-accent);
  }

  .tv-hero__kicker-bar {
    width: 26px;
    height: 1px;
    background: var(--tv-accent);
  }

  .tv-hero__title {
    margin: 0;
    font-family: 'Instrument Serif', Georgia, serif;
    font-weight: 400;
    font-size: clamp(44px, 7vw, 84px);
    line-height: 0.98;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .tv-hero__lede {
    margin: 30px 0 0;
    max-width: 30em;
    font-size: 18.5px;
    line-height: 1.55;
    color: var(--tv-sub);
    text-wrap: pretty;
  }

  .tv-hero__actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 40px;
  }

  .tv-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 15px 26px;
    border-radius: 2px;
    font-size: 14.5px;
    font-weight: 500;
    transition: background 120ms, border-color 120ms, color 120ms;
  }

  .tv-arrow {
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
  }

  .tv-home a.tv-btn--primary {
    background: var(--tv-ink);
    color: var(--tv-paper);
  }

  .tv-home a.tv-btn--primary:hover {
    background: var(--tv-accent);
    color: #ffffff;
  }

  .tv-btn--ghost {
    padding: 15px 24px;
    border: 1px solid var(--tv-faint-3);
  }

  .tv-home a.tv-btn--ghost {
    color: var(--tv-ink);
  }

  .tv-btn--ghost:hover {
    border-color: var(--tv-ink);
  }

  .tv-home a.tv-btn--inverse {
    background: var(--tv-paper);
    color: var(--tv-ink);
  }

  .tv-home a.tv-btn--inverse:hover {
    background: var(--tv-accent);
    color: #ffffff;
  }

  /* ---------------- Progress card ---------------- */

  .tv-progress {
    border: 1px solid var(--tv-border);
    background: var(--tv-card);
    padding: 30px clamp(20px, 3vw, 30px) 26px;
    min-width: 0;
  }

  .tv-progress__top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }

  .tv-progress__label {
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--tv-mute);
  }

  .tv-progress__saved {
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 10.5px;
    letter-spacing: 0.08em;
    color: var(--tv-faint-5);
  }

  .tv-progress__count {
    display: flex;
    align-items: baseline;
    gap: 9px;
    margin: 16px 0 20px;
  }

  .tv-progress__big {
    font-family: 'Instrument Serif', Georgia, serif;
    font-size: 62px;
    line-height: 0.85;
    letter-spacing: -0.02em;
  }

  .tv-progress__of {
    font-size: 14.5px;
    color: var(--tv-mute);
  }

  .tv-progress__bar {
    height: 3px;
    background: var(--tv-border-2);
    margin-bottom: 22px;
  }

  .tv-progress__bar-fill {
    height: 3px;
    background: var(--tv-accent);
    transition: width 200ms ease;
  }

  .tv-progress__grid {
    display: grid;
    grid-template-columns: repeat(10, 1fr);
    gap: 5px;
  }

  .tv-progress__cell {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1;
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 10px;
    border: 1px solid var(--tv-faint-4);
    background: transparent;
    color: var(--tv-faint);
  }

  a.tv-progress__cell:hover {
    border-color: var(--tv-ink);
  }

  .tv-progress__cell--stub {
    color: var(--tv-faint-2);
    cursor: default;
  }

  .tv-progress__cell--filled {
    border-color: var(--tv-accent);
    background: var(--tv-accent);
    color: #ffffff;
  }

  .tv-progress__next {
    margin: 20px 0 0;
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--tv-mute-2);
  }

  /* ---------------- Ticker ---------------- */

  .tv-ticker {
    margin: clamp(48px, 8vw, 84px) 0 0;
    padding: 13px 0;
    border-top: 1px solid var(--tv-border);
    border-bottom: 1px solid var(--tv-border);
    overflow: hidden;
    white-space: nowrap;
  }

  .tv-ticker__track {
    display: inline-block;
    animation: tv-tick 46s linear infinite;
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 11px;
    letter-spacing: 0.16em;
    color: var(--tv-ticker-text);
  }

  @keyframes tv-tick {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .tv-ticker__track {
      animation: none;
    }
  }

  /* ---------------- Track / roadmap ---------------- */

  .tv-track {
    padding: clamp(56px, 8vw, 96px) 0 40px;
  }

  .tv-track__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px 24px;
    padding-bottom: 22px;
    border-bottom: 1px solid var(--tv-ink);
  }

  .tv-track__header h2 {
    margin: 0;
    font-family: 'Instrument Serif', Georgia, serif;
    font-weight: 400;
    font-size: 40px;
    letter-spacing: -0.02em;
  }

  .tv-track__meta {
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--tv-mute);
  }

  @media (max-width: 480px) {
    .tv-track__meta {
      white-space: normal;
      max-width: 100%;
    }
  }

  .tv-week {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(20px, 4vw, 56px);
    padding: clamp(32px, 4vw, 46px) 0;
    border-bottom: 1px solid var(--tv-border);
    scroll-margin-top: 84px;
  }

  .tv-week__side {
    flex: 1 1 200px;
    min-width: 0;
  }

  .tv-week__num {
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 11px;
    letter-spacing: 0.16em;
    color: var(--tv-faint);
  }

  .tv-week__title {
    margin: 12px 0 0;
    font-family: 'Instrument Serif', Georgia, serif;
    font-weight: 400;
    font-size: 27px;
    line-height: 1.15;
    letter-spacing: -0.015em;
    text-wrap: pretty;
  }

  .tv-week__meta {
    margin-top: 14px;
    font-size: 13px;
    color: var(--tv-mute-2);
  }

  .tv-week__days {
    flex: 4 1 320px;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .tv-day-row {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px 14px;
    border-bottom: 1px solid var(--tv-border-2);
    transition: background 120ms;
  }

  a.tv-day-row:hover {
    background: color-mix(in srgb, var(--tv-ink) 5%, transparent);
  }

  .tv-day-row[aria-disabled='true'] {
    cursor: default;
    opacity: 0.6;
  }

  .tv-day-row__num {
    flex: none;
    width: 26px;
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 12px;
    color: var(--tv-faint);
  }

  .tv-day-row__title {
    flex: 1;
    font-size: 15.5px;
    line-height: 1.4;
    color: var(--tv-ink);
    text-wrap: pretty;
  }

  .tv-pill {
    flex: none;
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 9.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--tv-accent);
    border: 1px solid var(--tv-accent-soft-border);
    background: var(--tv-accent-soft-bg);
    padding: 4px 7px;
  }

  .tv-day-row__arrow {
    flex: none;
    width: 18px;
    text-align: right;
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 13px;
    color: var(--tv-faint-2);
  }

  .tv-day-row__soon {
    flex: none;
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 10px;
    letter-spacing: 0.1em;
    color: var(--tv-faint-2);
  }

  .tv-day-row.is-done .tv-day-row__num {
    color: var(--tv-accent);
  }

  .tv-day-row.is-current .tv-day-row__title {
    font-weight: 600;
  }

  .tv-day-row.is-current .tv-day-row__num {
    color: var(--tv-accent);
  }

  /* ---------------- Closing CTA ---------------- */

  .tv-cta {
    padding: clamp(52px, 6vw, 76px) 0 clamp(64px, 7vw, 96px);
  }

  .tv-cta__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: clamp(28px, 4vw, 40px);
    flex-wrap: wrap;
    background: var(--tv-ink);
    color: var(--tv-paper);
    padding: clamp(36px, 5vw, 54px) clamp(24px, 5vw, 56px);
  }

  .tv-cta__copy {
    min-width: 0;
  }

  .tv-cta__copy h2 {
    margin: 0;
    font-family: 'Instrument Serif', Georgia, serif;
    font-weight: 400;
    font-size: 46px;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  .tv-cta__copy p {
    margin: 14px 0 0;
    font-size: 16px;
    color: var(--tv-faint);
  }

  @media (max-width: 640px) {
    .tv-progress__grid {
      grid-template-columns: repeat(6, 1fr);
    }
  }
</style>
