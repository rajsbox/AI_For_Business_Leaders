---
import BaseLayout from './BaseLayout.astro';
import DayToc from '../components/DayToc.astro';
import DayTabs from '../components/DayTabs.astro';
import ModelLandscape from '../components/ModelLandscape.astro';
import { days, weekTitle } from '../data/course';

interface Props {
  day: number;
  week: number;
  title: string;
  duration: string;
  handsOn: boolean;
  published: boolean;
  nextPublished?: boolean;
}

const { day, week, title, duration, handsOn, published, nextPublished = false } = Astro.props;

const prev = days.find((d) => d.day === day - 1);
const next = days.find((d) => d.day === day + 1);
const total = days.length;
// See BaseLayout.astro for why this normalizes to a guaranteed trailing slash.
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout title={`Day ${day} — ${title} | AI Fluency for Leaders`}>
  <nav class="day-breadcrumb" id="day-breadcrumb">
    <div class="container day-breadcrumb__row">
      <div class="day-breadcrumb__path">
        <a href={base}>ROADMAP</a>
        <span class="day-breadcrumb__sep">/</span>
        <a href={`${base}#week-${week}`}>WEEK {week}</a>
        <span class="day-breadcrumb__sep">/</span>
        <span class="day-breadcrumb__current">DAY {day}</span>
      </div>
    </div>
  </nav>

  <main class="container day-page">
    <header class="day-header">
      <div class="day-header__badges">
        <span class="badge badge--week-tag">WEEK {String(week).padStart(2, '0')} · {weekTitle(week).toUpperCase()}</span>
        <span class="badge badge--state">
          {published ? 'READY' : 'LOCKED'}
        </span>
      </div>
      <div class="day-header__main">
        <div class="day-header__num">{String(day).padStart(2, '0')}</div>
        <div class="day-header__body">
          <div class="day-header__meta">
            <span>DAY {day} · {duration.toUpperCase()} · <span id="day-section-count">{'—'}</span> SECTIONS</span>
            {handsOn && <span class="badge badge--hands-on">Hands-on</span>}
          </div>
          <h1 class="day-header__title">{title}</h1>
        </div>
      </div>
    </header>

    <div class="day-body">
      {/*
        DayTabs (when published) is placed before the sidebar in source order
        so its inline script — which lifts <DayApply> sections out of Read
        before DayToc scans headings — runs first. Visual position is set
        explicitly via grid-column below, independent of source order.
      */}
      <div class="day-main">
        {published ? (
          <DayTabs day={day}>
            <slot />
          </DayTabs>
        ) : (
          <article class="day-placeholder-wrap day-content card">
            <div class="day-placeholder">
              <p><strong>This day's lesson hasn't been written yet.</strong></p>
              <p>Content for Day {day} will appear here once it's added to <code>src/content/days/day-{String(day).padStart(2, '0')}.mdx</code>.</p>
            </div>
          </article>
        )}
      </div>

      <aside class="day-sidebar">
        <ModelLandscape />
        {published && <DayToc />}
      </aside>
    </div>

    {published && (
      <div class="day-action-row">
        <div class="day-action-row__buttons">
          {prev && (
            <a class="day-action-row__prev" href={`${base}day/${prev.day}`}>← Day {prev.day}</a>
          )}
          {next ? (
            nextPublished ? (
              <a class="day-action-row__next" href={`${base}day/${next.day}`}>
                {`DAY ${String(next.day).padStart(2, '0')} · ${next.title.length > 36 ? next.title.slice(0, 36) + '…' : next.title}`}
              </a>
            ) : (
              <span class="day-action-row__next day-action-row__next--soon">{`DAY ${String(next.day).padStart(2, '0')} · SOON`}</span>
            )
          ) : (
            <span class="day-action-row__next day-action-row__next--end">COURSE COMPLETE</span>
          )}
        </div>
      </div>
    )}
  </main>
</BaseLayout>

<script>
  // Section count in the day header meta line, derived from rendered h2 headings.
  function initSectionCount() {
    const el = document.getElementById('day-section-count');
    const article = document.querySelector<HTMLElement>('.day-content');
    if (!el || !article) return;
    const count = article.querySelectorAll('h2').length;
    el.textContent = String(count);
  }

  function init() {
    initSectionCount();
  }

  init();
  document.addEventListener('astro:page-load', init);
</script>

<style>
  .day-breadcrumb {
    position: sticky;
    top: 60px;
    z-index: 15;
    background: var(--paper);
    border-bottom: 1px solid var(--rule);
  }

  .day-breadcrumb__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 11px 28px 9px;
  }

  .day-breadcrumb__path {
    display: flex;
    align-items: center;
    gap: 9px;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.12em;
  }

  .day-breadcrumb__path a {
    color: var(--blue);
  }

  .day-breadcrumb__path a:hover {
    color: var(--ink);
  }

  .day-breadcrumb__sep {
    color: var(--faint);
  }

  .day-breadcrumb__current {
    color: var(--mute);
  }

  .day-page {
    max-width: 1280px;
    padding: 32px 24px 96px;
  }

  .day-body {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: 40px;
    align-items: start;
  }

  /*
    Explicit placement: .day-main is second in source order (see comment in
    the template above) but belongs in the wide column visually, and
    .day-sidebar is the opposite. Grid-column placement is independent of
    source order, so this doesn't fight the script-ordering requirement.
  */
  .day-main {
    grid-column: 2;
    min-width: 0;
  }

  .day-sidebar {
    grid-column: 1;
    grid-row: 1;
    position: sticky;
    top: 84px;
    max-height: calc(100vh - 110px);
    overflow-y: auto;
    display: flex;
    flex-direction: column;
  }

  @media (max-width: 960px) {
    .day-body {
      grid-template-columns: minmax(0, 1fr);
    }
    .day-main {
      grid-column: 1;
    }
    .day-sidebar {
      grid-column: 1;
      position: static;
      max-height: none;
    }
  }

  .day-header {
    padding: 38px 0 24px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .day-header__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .badge--week-tag {
    background: var(--rule);
    color: var(--paper);
  }

  .badge--state {
    border: 2px solid var(--blue);
    color: var(--blue);
    background: transparent;
  }

  .day-header__main {
    display: flex;
    flex-wrap: wrap;
    gap: 26px;
    align-items: flex-start;
    padding-bottom: 24px;
    border-bottom: 2px solid var(--rule);
  }

  .day-header__num {
    font-weight: 900;
    font-size: clamp(62px, 9vw, 104px);
    line-height: 0.78;
    letter-spacing: -0.07em;
    color: var(--blue);
  }

  .day-header__body {
    flex: 1 1 420px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .day-header__meta {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    color: var(--mute);
  }

  .day-header__title {
    margin: 0;
    font-weight: 900;
    font-size: clamp(26px, 3.6vw, 40px);
    line-height: 1.04;
    letter-spacing: -0.035em;
  }

  /*
    Markdown/lesson typography for .day-content lives in DayTabs.astro now
    (that's where the element is actually rendered when a day is published).
    .day-placeholder below is the unpublished-day fallback, still rendered
    directly by this layout, so its .day-content wrapper only needs padding —
    kept minimal here rather than duplicating the typography rules.
  */
  .day-placeholder-wrap.day-content {
    padding: 32px clamp(20px, 4vw, 48px);
    margin-bottom: 36px;
    font-family: var(--font-sans);
  }

  .day-placeholder {
    font-family: var(--font-sans);
    color: var(--color-text-muted);
  }

  .day-placeholder code {
    background: var(--color-accent-soft);
    padding: 0.15em 0.45em;
    border-radius: 4px;
    font-size: 0.9em;
  }

  .day-action-row {
    margin-top: 28px;
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    align-items: center;
    justify-content: space-between;
    border-top: 2px solid var(--rule);
    padding-top: 22px;
  }

  .day-action-row__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
  }

  .day-action-row__prev {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 0.76rem;
    letter-spacing: 0.02em;
    color: var(--mute);
    padding: 14px 8px;
  }

  .day-action-row__prev:hover {
    color: var(--blue);
  }

  .day-action-row__next,
  .day-action-row__next--soon {
    padding: 14px 22px;
    border: 2px solid var(--faint);
    color: var(--mute);
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  a.day-action-row__next:hover {
    border-color: var(--blue);
    color: var(--blue);
  }

  .day-action-row__next--end {
    color: var(--blue);
    border-color: var(--blue);
  }

  @media (max-width: 640px) {
    .day-action-row {
      flex-direction: column;
      align-items: stretch;
    }
    .day-action-row__buttons {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
