---
import BaseLayout from './BaseLayout.astro';
import DayToc from '../components/DayToc.astro';
import DayTabs from '../components/DayTabs.astro';
import ModelLandscape from '../components/ModelLandscape.astro';
import { days, weekTitle } from '../data/course';

interface Props {
  day: number;
  week: number;
  title: string;
  duration: string;
  handsOn: boolean;
  published: boolean;
}

const { day, week, title, duration, handsOn, published } = Astro.props;

const prev = days.find((d) => d.day === day - 1);
const next = days.find((d) => d.day === day + 1);
const total = days.length;
const progressPct = Math.round((day / total) * 100);
---

<BaseLayout title={`Day ${day} — ${title} | AI Fluency for Leaders`}>
  <div class="reading-progress" id="reading-progress" aria-hidden="true">
    <div class="reading-progress__bar" id="reading-progress-bar"></div>
  </div>

  <main class="container day-page">
    <nav class="day-crumb">
      <a href="/">← THE TRACK</a>
      <span class="day-crumb__meta">DAY {String(day).padStart(2, '0')} / {total}</span>
    </nav>

    <div class="day-progress" role="progressbar" aria-valuenow={day} aria-valuemin="1" aria-valuemax={total} aria-label={`Course progress: day ${day} of ${total}`}>
      <div class="day-progress__bar" style={`width:${progressPct}%`}></div>
    </div>

    <header class="day-header">
      <div class="day-header__num">{String(day).padStart(2, '0')}</div>
      <div class="day-header__body">
        <div class="day-header__meta">
          <span>WEEK {String(week).padStart(2, '0')} · DAY {String(day).padStart(2, '0')} · {duration.toUpperCase()}</span>
          {handsOn && <span class="badge badge--hands-on">Hands-on</span>}
          {published
            ? <span class="badge badge--done">Ready</span>
            : <span class="badge badge--soon">Coming soon</span>}
        </div>
        <h1 class="day-header__title">{title}</h1>
      </div>
    </header>

    <div class="day-body">
      {/*
        DayTabs (when published) is placed before the sidebar in source order
        so its inline script — which lifts <DayApply> sections out of Read
        before DayToc scans headings — runs first. Visual position is set
        explicitly via grid-column below, independent of source order.
      */}
      <div class="day-main">
        {published ? (
          <DayTabs day={day}>
            <slot />
          </DayTabs>
        ) : (
          <article class="day-placeholder-wrap day-content card">
            <div class="day-placeholder">
              <p><strong>This day's lesson hasn't been written yet.</strong></p>
              <p>Content for Day {day} will appear here once it's added to <code>src/content/days/day-{String(day).padStart(2, '0')}.mdx</code>.</p>
            </div>
          </article>
        )}
      </div>

      <aside class="day-sidebar">
        <ModelLandscape />
        {published && <DayToc />}
      </aside>
    </div>

    <nav class="day-pager">
      {prev ? (
        <a class="day-pager__link day-pager__link--prev" href={`/day/${prev.day}`}>
          <span class="day-pager__label">← Day {prev.day}</span>
          <span class="day-pager__title">{prev.title}</span>
        </a>
      ) : <span />}
      {next ? (
        <a class="day-pager__link day-pager__link--next" href={`/day/${next.day}`}>
          <span class="day-pager__label">Day {next.day} →</span>
          <span class="day-pager__title">{next.title}</span>
        </a>
      ) : <span />}
    </nav>
  </main>
</BaseLayout>

<script>
  // Reading-progress bar: fills as the user scrolls through the article specifically
  // (not the whole page), so it reflects lesson progress rather than page length.
  function initReadingProgress() {
    const bar = document.getElementById('reading-progress-bar');
    const article = document.querySelector<HTMLElement>('.day-content');
    if (!bar || !article) return;

    function update() {
      const rect = article!.getBoundingClientRect();
      const articleTop = rect.top + window.scrollY;
      const articleHeight = article!.offsetHeight;
      const viewportH = window.innerHeight;
      const scrolled = window.scrollY - articleTop + viewportH * 0.5;
      const pct = Math.min(100, Math.max(0, (scrolled / articleHeight) * 100));
      bar!.style.width = `${pct}%`;
    }

    update();
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
  }

  initReadingProgress();
  document.addEventListener('astro:page-load', initReadingProgress);
</script>

<style>
  .reading-progress {
    position: fixed;
    top: 64px;
    left: 0;
    right: 0;
    height: 3px;
    z-index: 19;
    background: transparent;
  }

  .reading-progress__bar {
    height: 100%;
    width: 0%;
    background: var(--color-accent);
    transition: width 0.08s linear;
  }

  .day-page {
    padding: 32px 24px 96px;
  }

  .day-body {
    display: grid;
    grid-template-columns: 260px minmax(0, 1fr);
    gap: 40px;
    align-items: start;
  }

  /*
    Explicit placement: .day-main is second in source order (see comment in
    the template above) but belongs in the wide column visually, and
    .day-sidebar is the opposite. Grid-column placement is independent of
    source order, so this doesn't fight the script-ordering requirement.
  */
  .day-main {
    grid-column: 2;
    min-width: 0;
  }

  .day-sidebar {
    grid-column: 1;
    grid-row: 1;
    position: sticky;
    top: 84px;
    max-height: calc(100vh - 110px);
    overflow-y: auto;
    display: flex;
    flex-direction: column;
  }

  @media (max-width: 960px) {
    .day-body {
      grid-template-columns: minmax(0, 1fr);
    }
    .day-main {
      grid-column: 1;
    }
    .day-sidebar {
      grid-column: 1;
      position: static;
      max-height: none;
    }
  }

  .day-crumb {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    margin-bottom: 20px;
  }

  .day-crumb a {
    color: var(--sub);
  }

  .day-crumb a:hover {
    color: var(--blue);
  }

  .day-crumb__meta {
    color: var(--mute);
    font-weight: 500;
  }

  .day-progress {
    height: 6px;
    border: 1px solid var(--rule);
    overflow: hidden;
    margin-bottom: 28px;
  }

  .day-progress__bar {
    height: 100%;
    background: var(--blue);
  }

  .day-header {
    display: flex;
    flex-wrap: wrap;
    gap: 22px;
    align-items: flex-start;
    padding-bottom: 26px;
    margin-bottom: 28px;
    border-bottom: 2px solid var(--rule);
  }

  .day-header__num {
    font-weight: 900;
    font-size: clamp(56px, 9vw, 96px);
    line-height: 0.8;
    letter-spacing: -0.07em;
    color: var(--blue);
  }

  .day-header__body {
    flex: 1 1 320px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .day-header__meta {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    color: var(--mute);
  }

  .day-header__title {
    margin: 0;
    font-weight: 900;
    font-size: clamp(22px, 3.2vw, 34px);
    line-height: 1.08;
    letter-spacing: -0.03em;
  }

  /*
    Markdown/lesson typography for .day-content lives in DayTabs.astro now
    (that's where the element is actually rendered when a day is published).
    .day-placeholder below is the unpublished-day fallback, still rendered
    directly by this layout, so its .day-content wrapper only needs padding —
    kept minimal here rather than duplicating the typography rules.
  */
  .day-placeholder-wrap.day-content {
    padding: 32px clamp(20px, 4vw, 48px);
    margin-bottom: 36px;
    font-family: var(--font-sans);
  }

  .day-placeholder {
    font-family: var(--font-sans);
    color: var(--color-text-muted);
  }

  .day-placeholder code {
    background: var(--color-accent-soft);
    padding: 0.15em 0.45em;
    border-radius: 4px;
    font-size: 0.9em;
  }

  .day-pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: 40px;
  }

  .day-pager__link {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 16px 18px;
    border: 2px solid var(--faint);
    background: var(--card);
  }

  .day-pager__link:hover {
    border-color: var(--blue);
  }

  .day-pager__link--next {
    text-align: right;
    grid-column: 2;
  }

  .day-pager__label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--blue);
    letter-spacing: 0.08em;
  }

  .day-pager__title {
    color: var(--sub);
    font-size: 0.86rem;
  }

  @media (max-width: 640px) {
    .day-pager {
      grid-template-columns: 1fr;
    }
    .day-pager__link--next {
      grid-column: 1;
      text-align: left;
    }
  }
</style>
