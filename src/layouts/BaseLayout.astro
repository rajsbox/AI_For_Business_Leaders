---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = '30-Day AI Fluency Course for Business Leaders — a daily, no-fluff path to speaking AI credibly and making better AI decisions.',
} = Astro.props;

// Astro's BASE_URL reflects astro.config's `base` verbatim (no guaranteed
// trailing slash) — normalize once here so every `${base}day/1`-style
// concatenation downstream is safe.
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <script is:inline>
      // Apply saved theme before paint to avoid flash-of-wrong-theme.
      (function () {
        try {
          const saved = localStorage.getItem('theme');
          if (saved === 'light' || saved === 'dark') {
            document.documentElement.setAttribute('data-theme', saved);
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="container site-header__inner">
        <a class="brand" href={base}>
          <span class="brand__mark">AI</span>
          <span>Fluency for Leaders</span>
        </a>
        <nav class="site-nav">
          <a href={`${base}#roadmap`}><span class="site-nav__label">Roadmap</span></a>
          <a href={`${base}#week-1`}>Weeks</a>
          <a href={`${base}adoption-stories`}>Adoption</a>
          <a href={`${base}ai-metrics`}>Metrics</a>
          <a href={`${base}future-topics`}>Future</a>
          <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Toggle dark mode">
            <span id="theme-toggle-icon">☾</span>
          </button>
        </nav>
      </div>
    </header>

    <slot />

    <footer class="site-footer">
      <div class="site-footer__top">
        <div class="site-footer__headline">
          <h2>One topic<br /><span>a day.</span></h2>
          <a class="site-footer__cta" href={`${base}day/1`}>Start Day 1</a>
        </div>
        <nav class="site-footer__nav">
          <a href={`${base}#roadmap`}>Roadmap</a>
          <a href={`${base}#roadmap`}>All 30 days</a>
          <a href={`${base}adoption-stories`}>Actual adoption</a>
          <a href={`${base}ai-metrics`}>AI metrics</a>
          <a href={`${base}future-topics`}>Future topics</a>
          <button type="button" id="footer-theme-toggle">Switch theme</button>
        </nav>
      </div>
      <div class="site-footer__bottom">
        <span class="site-footer__credit">AI Fluency for Business Leaders · 30 Days</span>
        <div class="site-footer__bottom-right">
          <img
            class="site-footer__visitor-badge"
            src="https://visitor-badge.laobi.icu/badge?page_id=ai-fluency-for-business-leaders.rajsbox&text=Visitors&left_color=grey&right_color=%231f3bff"
            alt="Visitor count"
            loading="lazy"
            width="110"
            height="20"
          />
          <div class="site-footer__badge-row">
            <span>Designed by</span>
            <a
              class="site-footer__linkedin"
              href="https://www.linkedin.com/in/rajs-box/"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="LinkedIn profile"
              title="LinkedIn profile"
            >
              <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true">
                <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.38-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14zM7.12 20.45H3.56V9h3.56v11.45z"/>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </footer>

    <script is:inline>
      (function () {
        const btn = document.getElementById('theme-toggle');
        const icon = document.getElementById('theme-toggle-icon');
        const footerBtn = document.getElementById('footer-theme-toggle');
        function current() {
          return document.documentElement.getAttribute('data-theme') ||
            (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        }
        function paintIcon() {
          if (icon) icon.textContent = current() === 'dark' ? '☀' : '☾';
        }
        function toggle() {
          const next = current() === 'dark' ? 'light' : 'dark';
          document.documentElement.setAttribute('data-theme', next);
          try {
            localStorage.setItem('theme', next);
          } catch (e) {}
          paintIcon();
        }
        paintIcon();
        btn?.addEventListener('click', toggle);
        footerBtn?.addEventListener('click', toggle);
      })();
    </script>
  </body>
</html>
