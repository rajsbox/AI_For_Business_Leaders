---
// Sticky in-page table of contents with scroll-spy, built by scanning the
// rendered day-content article for h2 headings at runtime (so it always
// matches whatever headings exist, per day, with no manual list to maintain).
---

<aside class="day-toc" id="day-toc" aria-label="On this page">
  <p class="day-toc__label">On this page</p>
  <ol class="day-toc__list" id="day-toc-list"></ol>
</aside>

<style>
  .day-toc__label {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--mute);
    margin: 0 0 10px;
  }

  .day-toc__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
    border-left: 2px solid var(--faint);
  }

  .day-toc :global(.day-toc__link) {
    display: block;
    padding: 6px 0 6px 14px;
    margin-left: -2px;
    border-left: 2px solid transparent;
    font-size: 0.84rem;
    font-weight: 500;
    color: var(--sub);
    line-height: 1.4;
  }

  .day-toc :global(.day-toc__link:hover) {
    color: var(--ink);
  }

  .day-toc :global(.day-toc__link.is-active) {
    color: var(--blue);
    border-left-color: var(--blue);
    font-weight: 700;
  }

  .day-toc__empty {
    font-size: 0.85rem;
    color: var(--mute);
  }

  @media (max-width: 960px) {
    .day-toc {
      display: none;
    }
  }
</style>

<script>
  function initToc() {
    const toc = document.getElementById('day-toc');
    const list = document.getElementById('day-toc-list');
    const article = document.querySelector<HTMLElement>('.day-content');
    if (!toc || !list || !article) return;
    if (list.dataset.built === 'true') return;
    list.dataset.built = 'true';

    const headings = Array.from(article.querySelectorAll<HTMLElement>('h2'));

    if (headings.length === 0) {
      toc.style.display = 'none';
      return;
    }

    const links: HTMLAnchorElement[] = [];

    headings.forEach((h, i) => {
      if (!h.id) {
        const slug = (h.textContent || `section-${i}`)
          .toLowerCase()
          .trim()
          .replace(/[^\w\s-]/g, '')
          .replace(/\s+/g, '-');
        h.id = slug || `section-${i}`;
      }

      const li = document.createElement('li');
      const a = document.createElement('a');
      a.href = `#${h.id}`;
      a.className = 'day-toc__link';
      a.textContent = h.textContent;
      li.appendChild(a);
      list.appendChild(li);
      links.push(a);
    });

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const id = (entry.target as HTMLElement).id;
          const link = links.find((a) => a.getAttribute('href') === `#${id}`);
          if (!link) return;
          if (entry.isIntersecting) {
            links.forEach((a) => a.classList.remove('is-active'));
            link.classList.add('is-active');
          }
        });
      },
      { rootMargin: '-80px 0px -70% 0px', threshold: 0 }
    );

    headings.forEach((h) => observer.observe(h));
  }

  initToc();
  document.addEventListener('astro:page-load', initToc);
</script>
