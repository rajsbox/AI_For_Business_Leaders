---
// Nested-box diagram showing how AI / Machine Learning / Deep Learning /
// Generative AI relate as one another's subset, with Agentic AI shown as a
// capability layered on top rather than another box in the nest.
---

<div class="jmd">
  <div class="jmd__nest">
    <div class="jmd__box jmd__box--ai">
      <p class="jmd__label">Artificial Intelligence</p>
      <p class="jmd__sub">Any software that performs tasks that normally need human thinking</p>

      <div class="jmd__box jmd__box--ml">
        <p class="jmd__label">Machine Learning</p>
        <p class="jmd__sub">Software that improves by learning from examples, not fixed rules</p>

        <div class="jmd__box jmd__box--dl">
          <p class="jmd__label">Deep Learning</p>
          <p class="jmd__sub">Machine learning using large, layered neural networks</p>

          <div class="jmd__box jmd__box--genai">
            <p class="jmd__label">Generative AI</p>
            <p class="jmd__sub">Deep learning that creates new text, images, or audio</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="jmd__agentic">
    <div class="jmd__arrow" aria-hidden="true">+</div>
    <div class="jmd__box jmd__box--agentic">
      <p class="jmd__label">Agentic AI</p>
      <p class="jmd__sub">Generative AI given the ability to take actions, not just produce text</p>
    </div>
  </div>
</div>

<style>
  .jmd {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 18px;
    margin: 1.6em 0;
    font-family: var(--font-sans);
  }

  .jmd__nest {
    flex: 1 1 320px;
  }

  .jmd__box {
    border: 2px solid var(--rule);
    background: var(--card);
    padding: 16px;
  }

  .jmd__box--ai {
    padding: 20px;
  }

  .jmd__box--ml {
    margin-top: 14px;
    background: color-mix(in srgb, var(--blue) 4%, var(--card));
  }

  .jmd__box--dl {
    margin-top: 14px;
    background: color-mix(in srgb, var(--blue) 8%, var(--card));
  }

  .jmd__box--genai {
    margin-top: 14px;
    background: color-mix(in srgb, var(--blue) 14%, var(--card));
  }

  .jmd__label {
    margin: 0 0 4px;
    font-weight: 800;
    font-size: 0.95rem;
    color: var(--ink);
    letter-spacing: -0.01em;
  }

  .jmd__box--dl .jmd__label,
  .jmd__box--genai .jmd__label {
    font-size: 0.88rem;
  }

  .jmd__sub {
    margin: 0;
    font-size: 0.78rem;
    line-height: 1.4;
    color: var(--mute);
  }

  .jmd__agentic {
    flex: 0 1 200px;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .jmd__arrow {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--mute);
  }

  .jmd__box--agentic {
    background: color-mix(in srgb, var(--blue) 90%, var(--card));
    border-color: var(--blue);
  }

  .jmd__box--agentic .jmd__label {
    color: var(--blue-contrast);
  }

  .jmd__box--agentic .jmd__sub {
    color: color-mix(in srgb, var(--blue-contrast) 75%, var(--blue));
  }

  @media (max-width: 640px) {
    .jmd__agentic {
      flex-basis: 100%;
      justify-content: center;
    }
    .jmd__arrow {
      transform: rotate(90deg);
    }
  }
</style>
