---
// Themed (light/dark aware) diagram showing the chain from "time saved" to
// real P&L impact, and where that chain most commonly breaks.
---

<div class="roic">
  <div class="roic__chain">
    <div class="roic__step">
      <strong>Time saved</strong>
      <span>A task takes less time per person</span>
    </div>
    <div class="roic__arrow" aria-hidden="true">
      <span>→</span>
      <p class="roic__question">Does it get redeployed to something valuable?</p>
    </div>
    <div class="roic__step">
      <strong>Capacity freed</strong>
      <span>Hours, headcount, or throughput open up</span>
    </div>
    <div class="roic__arrow" aria-hidden="true">
      <span>→</span>
      <p class="roic__question">Does that trace to a real cost or revenue line?</p>
    </div>
    <div class="roic__step roic__step--pnl">
      <strong>P&amp;L impact</strong>
      <span>Lower cost, more output, or faster revenue</span>
    </div>
  </div>

  <div class="roic__break">
    <p class="roic__break-label">Where the chain most often breaks</p>
    <p class="roic__break-text">
      Time saved on a task that was never a bottleneck, or "freed" hours nobody actually
      redeploys, stop the chain at the first arrow. A real productivity claim, with no
      P&amp;L impact.
    </p>
  </div>
</div>

<style>
  .roic {
    margin: 1.6em 0;
    font-family: var(--font-sans);
  }

  .roic__chain {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr;
    align-items: center;
    gap: 10px;
  }

  .roic__step {
    background: #14161c;
    border: 2px solid var(--rule);
    padding: 18px 16px;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  :root[data-theme='light'] .roic__step {
    background: #14161c;
  }

  .roic__step strong {
    color: #ffffff;
    font-size: 0.95rem;
  }

  .roic__step span {
    color: #9aa1ad;
    font-size: 0.78rem;
    line-height: 1.4;
  }

  .roic__step--pnl {
    border-color: rgba(16, 185, 129, 0.5);
    background: rgba(16, 185, 129, 0.14);
  }

  .roic__step--pnl strong {
    color: #ffffff;
  }

  .roic__step--pnl span {
    color: #a7ecd3;
  }

  .roic__arrow {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    text-align: center;
  }

  .roic__arrow span {
    font-size: 1.2rem;
    color: #6b7280;
  }

  .roic__question {
    margin: 0;
    font-size: 0.72rem;
    color: var(--mute);
    font-weight: 600;
    line-height: 1.3;
    max-width: 9em;
  }

  .roic__break {
    margin-top: 18px;
    padding: 14px 16px;
    border: 1px solid var(--color-warn);
    background: var(--color-warn-soft);
  }

  .roic__break-label {
    margin: 0 0 4px;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-warn);
  }

  .roic__break-text {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--sub);
  }

  @media (max-width: 720px) {
    .roic__chain {
      grid-template-columns: 1fr;
    }
    .roic__arrow {
      flex-direction: row;
      justify-content: center;
      gap: 10px;
    }
    .roic__question {
      max-width: none;
      text-align: left;
    }
  }
</style>
