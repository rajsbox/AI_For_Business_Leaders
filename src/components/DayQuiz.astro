---
interface QuizQuestion {
  q: string;
  options: string[];
  correct: number;
  explain: string;
}

interface Props {
  questions: QuizQuestion[];
}

const { questions } = Astro.props;
// Give each instance of this component a unique id in case a page ever has more than one.
const uid = `quiz-${Math.random().toString(36).slice(2, 9)}`;
---

<div class="day-quiz" data-quiz-id={uid}>
  <p class="day-quiz__intro">Three questions to test what actually stuck. No score is saved — this is just for you.</p>

  {questions.map((item, i) => (
    <div class="day-quiz__item" data-question-index={i}>
      <p class="day-quiz__question">{i + 1}. {item.q}</p>
      <div class="day-quiz__options" role="radiogroup">
        {item.options.map((opt, j) => (
          <button
            type="button"
            class="day-quiz__option"
            data-option-index={j}
            data-correct={j === item.correct ? 'true' : 'false'}
          >
            {opt}
          </button>
        ))}
      </div>
      <p class="day-quiz__explain" hidden>{item.explain}</p>
    </div>
  ))}

  <button type="button" class="btn btn--ghost day-quiz__reset" hidden>Try again</button>
</div>

<style>
  .day-quiz {
    font-family: var(--font-sans);
    margin-top: 0.5em;
  }

  .day-quiz__intro {
    color: var(--color-text-muted);
    font-size: 0.94rem;
  }

  .day-quiz__item {
    padding: 18px 0;
    border-top: 1px solid var(--color-border);
  }

  .day-quiz__item:last-of-type {
    border-bottom: 1px solid var(--color-border);
  }

  .day-quiz__question {
    font-weight: 600;
    font-size: 1rem;
    color: var(--color-text);
    margin: 0 0 12px;
  }

  .day-quiz__options {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .day-quiz__option {
    text-align: left;
    padding: 10px 14px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border-strong);
    background: var(--color-surface);
    color: var(--color-text);
    font-size: 0.92rem;
    cursor: pointer;
    font-family: var(--font-sans);
  }

  .day-quiz__option:hover:not(:disabled) {
    border-color: var(--color-accent);
  }

  .day-quiz__option:disabled {
    cursor: default;
  }

  .day-quiz__option.is-correct {
    border-color: var(--color-success);
    background: var(--color-success-soft);
    color: var(--color-success);
    font-weight: 600;
  }

  .day-quiz__option.is-wrong {
    border-color: var(--color-warn);
    background: var(--color-warn-soft);
    color: var(--color-warn);
  }

  .day-quiz__explain {
    margin: 12px 0 0;
    padding: 12px 14px;
    background: var(--color-accent-soft);
    border-radius: var(--radius-sm);
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .day-quiz__reset {
    margin-top: 20px;
  }
</style>

<script>
  // Runs client-side for every .day-quiz on the page. No framework needed —
  // just click handling + a bit of DOM state per question.
  function initQuizzes() {
    document.querySelectorAll<HTMLElement>('.day-quiz').forEach((quiz) => {
      if (quiz.dataset.quizInit === 'true') return;
      quiz.dataset.quizInit = 'true';

      const items = quiz.querySelectorAll<HTMLElement>('.day-quiz__item');
      const resetBtn = quiz.querySelector<HTMLButtonElement>('.day-quiz__reset');

      function answered() {
        return quiz.querySelectorAll('.day-quiz__item[data-answered="true"]').length;
      }

      function maybeShowReset() {
        if (resetBtn && answered() === items.length) {
          resetBtn.hidden = false;
        }
      }

      items.forEach((item) => {
        const options = item.querySelectorAll<HTMLButtonElement>('.day-quiz__option');
        const explain = item.querySelector<HTMLElement>('.day-quiz__explain');

        options.forEach((opt) => {
          opt.addEventListener('click', () => {
            if (item.dataset.answered === 'true') return;
            item.dataset.answered = 'true';

            const isCorrect = opt.dataset.correct === 'true';
            opt.classList.add(isCorrect ? 'is-correct' : 'is-wrong');

            if (!isCorrect) {
              const correctOpt = item.querySelector<HTMLButtonElement>('[data-correct="true"]');
              correctOpt?.classList.add('is-correct');
            }

            options.forEach((o) => (o.disabled = true));
            if (explain) explain.hidden = false;

            maybeShowReset();
          });
        });
      });

      resetBtn?.addEventListener('click', () => {
        items.forEach((item) => {
          item.dataset.answered = 'false';
          const explain = item.querySelector<HTMLElement>('.day-quiz__explain');
          if (explain) explain.hidden = true;
          item.querySelectorAll<HTMLButtonElement>('.day-quiz__option').forEach((opt) => {
            opt.disabled = false;
            opt.classList.remove('is-correct', 'is-wrong');
          });
        });
        resetBtn.hidden = true;
      });
    });
  }

  initQuizzes();
  document.addEventListener('astro:page-load', initQuizzes);
</script>
